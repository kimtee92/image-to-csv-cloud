GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# Only override if Google changes the OpenAI-compat base path
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# How uploads are prepared for the model. "lossless" (default) sends an unfiltered
# accuracy on dense forms — don't use it without re-benchmarking.
# LOSSLESS_MIN_SIDE=2000
# LOSSLESS_MAX_PIXELS=12000000

# Verify in/out/total columns against the totals printed on the form (and, for
# DTRs, that each row's times run forward through the day), repairing misread
# digits and flagging what it can't resolve. Set to 0 to disable.
# TIME_VERIFY=1

# Read every DTR row a second time from a magnified crop and flag cells where the
# two readings disagree. Roughly doubles cost and time per file, never overwrites
# anything, and is an imperfect detector — see the DTR section of README.md for the
# measured hit rate before turning it on.
# DTR_CROSSCHECK=0

# Retry rows the first repair pass could not settle against narrower, more
# magnified crops. Costs nothing on clean pages (it only fires on flagged rows).
# DTR_ESCALATE=1
# Optionally send that retry to a different model. Empty = same model, which is
# the default because the benchmark shows the model tier makes no difference here
# while magnification does.
# ESCALATION_MODEL=
